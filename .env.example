# Required secret for sessions and encrypted Listmonk credentials.
# Generate with: openssl rand -hex 32 (minimum 32 characters).
# Keep this value unchanged so stored credentials remain decryptable.
ENCYPTION_SECRET=

# Username for the single admin account; defaults to admin in Docker Compose.
ADMIN_USERNAME=admin

# Required admin login password, at least 12 characters.
ADMIN_PASSWORD=

# Public origin used in recipient links, without a path, query, or fragment.
# Use HTTPS in production; an HTTPS origin enables secure session cookies.
PUBLIC_BASE_URL=http://localhost:8080

# SQLite file path for direct Python runs; Compose fixes this to /data/app.sqlite3.
# For local development, set this to data/app.sqlite3.
DATABASE_PATH=/data/app.sqlite3
